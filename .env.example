# Naija Scholar V2 - environment template
# Copy to .env and fill in real values. Never commit .env.

APP_NAME=Naija Scholar V2
APP_BASE_URL=https://t.me/NaijaScholarBot
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Telegram BotFather token (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Public bot username (without the leading @) used for deep links / QR codes
TELEGRAM_BOT_USERNAME=LIA_StudyBot

# Paystack dashboard: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signature_key

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=naija_scholar
# Hosted Postgres (Render) - takes precedence over the POSTGRES_* block above when set
DATABASE_URL=

SQLITE_PATH=naija_scholar.sqlite3
ENABLE_SQLITE_FALLBACK=true

REDIS_URL=redis://localhost:6379/0

# Autonomous question seeder (background loop inside the app)
SEED_ENABLED=false
SEED_INTERVAL_HOURS=6

# Optional: cloud LLM for the seeder (used before falling back to Ollama)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=moonshot-v1-8k

# Comma-separated telegram IDs with full god-mode access
SUPER_ADMIN_IDS=

# Optional: SMS magic-link delivery (Termii / WATI)
TERMII_API_KEY=
WATI_API_KEY=

# Optional: local model generation
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1
OLLAMA_LATENCY_THRESHOLD_SECONDS=300
